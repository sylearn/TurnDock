{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TurnDock",
  "mainBinaryName": "turndock-desktop",
  "version": "0.1.0",
  "identifier": "app.turndock.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5199",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "回合",
        "url": "index.html",
        "width": 1080,
        "height": 740,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      },
      {
        "label": "quick",
        "title": "回合 · 快速回复",
        "url": "index.html#quick",
        "width": 560,
        "height": 480,
        "minWidth": 440,
        "minHeight": 360,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "让 AI 在需要你时停下来等你",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
