tuation hl-definition hl-string hl-begin hl-json\">\"</span>turndock<span class=\"hl-punctuation hl-definition hl-string hl-end hl-json\">\"</span></span><span class=\"hl-punctuation hl-separator hl-mapping hl-pair hl-json\">,</span>\n      </span><span class=\"hl-meta hl-mapping hl-key hl-json\"><span class=\"hl-string hl-quoted hl-double hl-json\"><span class=\"hl-punctuation hl-definition hl-string hl-begin hl-json\">\"</span>args<span class=\"hl-punctuation hl-definition hl-string hl-end hl-json\">\"</span></span></span><span class=\"hl-meta hl-mapping hl-value hl-json\"><span class=\"hl-punctuation hl-separator hl-mapping hl-key-value hl-json\">:</span> </span><span class=\"hl-meta hl-mapping hl-value hl-json\"><span class=\"hl-meta hl-sequence hl-json\"><span class=\"hl-punctuation hl-section hl-sequence hl-begin hl-json\">[</span><span class=\"hl-string hl-quoted hl-double hl-json\"><span class=\"hl-punctuation hl-definition hl-string hl-begin hl-json\">\"</span>mcp<span class=\"hl-punctuation hl-definition hl-string hl-end hl-json\">\"</span></span><span class=\"hl-punctuation hl-section hl-sequence hl-end hl-json\">]</span></span>\n    <span class=\"hl-punctuation hl-section hl-mapping hl-end hl-json\">}</span></span>\n  <span class=\"hl-punctuation hl-section hl-mapping hl-end hl-json\">}</span></span>\n<span class=\"hl-punctuation hl-section hl-mapping hl-end hl-json\">}</span></span>\n</span></code></pre>",
